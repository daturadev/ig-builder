# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Required for sourcing media. Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Required only for --publish. From a Business/Creator IG account you own,
# connected to a Facebook Page. See README "Publishing setup".
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional: pin the Graph API version.
GRAPH_API_VERSION=v20.0
