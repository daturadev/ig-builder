# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Set up one platform at a time; platforms without credentials are skipped.
# Full step-by-step instructions: docs/SETUP_APIS.md

# --- Media sourcing (required for drafting) ---
# Free key: https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Instagram (Graph Content Publishing API) ---
# Business/Creator account connected to a Facebook Page.
IG_USER_ID=
IG_ACCESS_TOKEN=
GRAPH_API_VERSION=v20.0

# --- Threads (Meta Threads API) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- YouTube (Data API v3, OAuth2) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_ACCESS_TOKEN=
# Leave off until your app passes TikTok's audit. Off = draft to your inbox
# (you tap Post in the app). "1" = direct post (audited apps only).
TIKTOK_DIRECT_POST=
